# Required: your Clockify API key (Profile Settings → API)
CLOCKIFY_API_KEY=your_api_key_here

# Optional: regional base URL override (default: https://api.clockify.me/api/v1)
# Examples:
#   https://euc1.clockify.me/api/v1
#   https://use2.clockify.me/api/v1
#   https://euw2.clockify.me/api/v1
#   https://apse2.clockify.me/api/v1
# CLOCKIFY_API_BASE_URL=https://api.clockify.me/api/v1

# Optional: Reports API base URL override (default: https://reports.api.clockify.me/v1)
# CLOCKIFY_REPORTS_BASE_URL=https://reports.api.clockify.me/v1
